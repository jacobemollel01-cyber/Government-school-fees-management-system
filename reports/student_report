<?php
require_once "../config/db.php";
require_once "../includes/header.php";

$student_id = isset($_GET['student_id']) ? (int)$_GET['student_id'] : 0;

// Fetch active students for the selection dropdown
$students_list = $conn->query("
    SELECT student_id, admission_no, full_name 
    FROM students 
    WHERE status = 'Active' 
    ORDER BY full_name ASC
");

$student = null;
$payments = null;
$food_contributions = null;

if ($student_id > 0) {
    // 1. Fetch Student Details
    $stmt = $conn->prepare("
        SELECT s.*, c.class_name, st.stream_name, se.academic_year
        FROM students s
        LEFT JOIN student_enrollments se ON s.student_id = se.student_id
        LEFT JOIN classes c ON se.class_id = c.class_id
        LEFT JOIN streams st ON se.stream_id = st.stream_id
        WHERE s.student_id = ?
    ");
    $stmt->bind_param("i", $student_id);
    $stmt->execute();
    $student = $stmt->get_result()->fetch_assoc();
    $stmt->close();

    // 2. Fetch Cash Payments
    $payments_stmt = $conn->prepare("
        SELECT p.*, ct.name AS contribution_name
        FROM payments p
        JOIN contribution_types ct ON p.contribution_type_id = ct.contribution_type_id
        WHERE p.student_id = ? AND p.status = 'Active'
        ORDER BY p.payment_date DESC
    ");
    $payments_stmt->bind_param("i", $student_id);
    $payments_stmt->execute();
    $payments = $payments_stmt->get_result();

    // 3. Fetch Food Contributions (Maize / Beans)
    $food_stmt = $conn->prepare("
        SELECT fc.*, ct.name AS contribution_name
        FROM food_contributions fc
        JOIN contribution_types ct ON fc.contribution_type_id = ct.contribution_type_id
        WHERE fc.student_id = ? AND fc.status = 'Active'
        ORDER BY fc.contribution_date DESC
    ");
    $food_stmt->bind_param("i", $student_id);
    $food_stmt->execute();
    $food_contributions = $food_stmt->get_result();
}
?>

